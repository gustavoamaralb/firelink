[Unit]
Description=firelink home page API (status, Akali scoreboard and household chat)
After=network.target

[Service]
# %USUARIO% and %HOME% are filled in by install.sh with the user who ran sudo
User=%USUARIO%
ExecStart=/usr/bin/python3 -I %HOME%/firelink-api/servidor.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
