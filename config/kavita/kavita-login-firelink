#!/bin/sh
# Links the Firelink sign-in style into Kavita's index.html. Kavita updates
# replace wwwroot/, so this runs before every Kavita start (systemd drop-in
# from instalar-login.sh); it never blocks Kavita from starting.
K="${1:-/opt/Kavita}"
W="$K/wwwroot"
CSS=/usr/local/share/firelink/firelink-login.css
[ -f "$W/index.html" ] && [ -f "$CSS" ] || exit 0
cp "$CSS" "$W/firelink-login.css" && chmod 644 "$W/firelink-login.css"
grep -q 'firelink-login.css' "$W/index.html" ||
    sed -i 's|</head>|<link rel="stylesheet" href="firelink-login.css"></head>|' "$W/index.html"
exit 0
